# Backend API base URL (ilsoftware-propman-api)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# Base domain: tenants live at <slug>.<base domain>, platform admin at admin.<base domain>
NEXT_PUBLIC_BASE_DOMAIN=localhost
# Public URLs of the root site, a tenant ({slug} is replaced) and the platform admin area
NEXT_PUBLIC_ROOT_URL=http://localhost:3000
NEXT_PUBLIC_TENANT_URL_TEMPLATE=http://{slug}.localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://admin.localhost:3000
