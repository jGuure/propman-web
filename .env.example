# Read at runtime by the server (not compiled into the build): change them and restart.
# Backend API base URL (ilsoftware-propman-api)
API_URL=http://localhost:8080/api/v1
# Base domain: tenants live at <slug>.<base domain>, platform admin at admin.<base domain>
BASE_DOMAIN=localhost
# Public URLs of the root site, a tenant ({slug} is replaced) and the platform admin area
ROOT_URL=http://localhost:3000
TENANT_URL_TEMPLATE=http://{slug}.localhost:3000
ADMIN_URL=http://admin.localhost:3000
